# Offline by default. The desk runs, reflects, and searches with no API key.
# Copy to .env and fill in a key only when you want a live model.

# mock keeps every reflection on this machine.
# openai means any OpenAI-compatible chat API (OpenAI, Groq, OpenRouter, Ollama, Azure).
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# local is a deterministic hashing embedder (no download, no key).
# openai uses LLM_BASE_URL, LLM_API_KEY, and EMBEDDING_MODEL.
# Notes stay in the vector space they were written in. Search does not mix spaces.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# sqlite for the one-command demo. For Postgres, use the hinga_app role
# from db/postgres_rls.sql — not a superuser.
# DATABASE_URL=postgresql+psycopg://hinga_app:replace-me@localhost:5432/hinga
DATABASE_URL=sqlite:///data/hinga.db

# Signs the demo persona cookie. Change this if anyone else can reach the process.
SESSION_SECRET=dev-only-change-me

# Fernet key for journal text at rest. Leave empty and the demo writes data/fernet.key.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
HINGA_FERNET_KEY=

HINGA_HOST=0.0.0.0
HINGA_PORT=8741
